    "@prisma/client": "^7.10.1",
    "@shadcn/react": "^0.3.1",
    "better-auth": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "embla-carousel-react": "^8.6.0",
